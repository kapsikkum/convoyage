# Caddy terminates HTTPS (automatic certificates) and proxies the API, including the /ws upgrade, to the server.
# LiveKit signalling is exposed at /livekit on the same name, so phones need only 443 plus LiveKit's media ports.
{$PUBLIC_HOST} {
	encode zstd gzip

	handle_path /livekit/* {
		reverse_proxy host.docker.internal:7880
	}

	handle {
		reverse_proxy server:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	request_body {
		max_size 20MB
	}
}
