# Copy to deploy/.env.prod and fill in. Generate secrets with: openssl rand -base64 48 | tr -d '\n='
PUBLIC_HOST=convoy.example.com
POSTGRES_PASSWORD=
JWT_SECRET=
# Optional: enables the /admin moderation routes (32+ characters).
ADMIN_TOKEN=

# Real mail for magic links (required in production).
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Convoyage <no-reply@example.com>

# Sign in with Apple / Google (bundle id / OAuth client ids). Unset = that provider answers 501.
APPLE_AUDIENCES=
GOOGLE_AUDIENCES=

# Voice. The host's public IPv4 is advertised as the WebRTC candidate; open 7881/tcp and 50000-50100/udp.
LIVEKIT_NODE_IP=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Media in S3-compatible storage (leave S3_BUCKET empty to use the local volume).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_FORCE_PATH_STYLE=0
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=media/

# Routing. Default is the bundled OSRM (start with --profile osrm after deploy/osrm-prepare.sh).
# OSRM_URL=http://osrm:5000

# Push (optional).
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=app.convoyage
APNS_ENV=production

# PhotoScout link (optional): all of URL and TOKEN_KEY, or none.
PHOTOSCOUT_URL=
PHOTOSCOUT_TOKEN_KEY=
PHOTOSCOUT_CLIENT_ID=convoyage
PHOTOSCOUT_CLIENT_SECRET=

# Route conditions (optional).
TFNSW_API_KEY=
FUELCHECK_API_KEY=
FUELCHECK_API_SECRET=
WAZE_HARVESTER_URL=
WAZE_HARVESTER_KEY=
