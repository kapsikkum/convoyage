# Copy to server/.env (or export in your shell). The server reads process.env only; use
# `node --env-file=.env` or your process manager to load a file.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Postgres. Leave unset in development to use an embedded pglite database in server/data/pgdata.
DATABASE_URL=postgres://convoyage:convoyage@127.0.0.1:5432/convoyage
# Run pending migrations at startup (always on for the embedded fallback).
AUTO_MIGRATE=0

# Access-token signing secret (HS256), 32+ characters. Required in production; in development an
# ephemeral one is generated each start (all tokens die on restart).
JWT_SECRET=change-me-to-a-long-random-string-0123456789
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=60

# Email magic link. MAIL_DEV=1 logs the link and returns it in the response (never in production).
MAIL_DEV=1
# Deep link / URL the emailed link points at; `?token=...` is appended.
MAGIC_LINK_BASE_URL=convoyage://auth/magic

# Sign in with Apple / Google: comma-separated accepted `aud` values. Unset = provider disabled.
APPLE_AUDIENCES=
GOOGLE_AUDIENCES=

# WebSocket dev authenticator (?dev_user=alice). Never in production.
CONVOYAGE_DEV_AUTH=0

# Media (local disk in dev; S3 is a stub).
MEDIA_DIR=data/media

# Behind a reverse proxy, trust X-Forwarded-For for rate limits.
TRUST_PROXY=0
# Set to 1 to turn off the HTTP rate limits (tests).
RATE_LIMIT_DISABLED=0

# Routing for navigation mode (GET /v1/route). The public demo server is rate-limited and not for production use.
OSRM_URL=https://router.project-osrm.org
# Rest-stop search (convoy.rest, automatic regroup) queries OpenStreetMap through Overpass; 5 s timeout, 10 min cache.
# Comma-separated list, tried in order; the public servers are often at capacity.
OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.openstreetmap.fr/api/interpreter
# Per-user limit on /v1/route requests per window.
ROUTE_RATE_LIMIT_MAX=30

# Push-to-talk voice (LiveKit). LIVEKIT_URL is the address the phones connect to (ws://<pc-lan-ip>:7880 on a LAN).
# Unset key/secret = POST /v1/voice/token answers 501. The secret should be 32+ characters.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=convoyage-dev-livekit-secret-0123456789
# Optional: the PC LAN IPv4, advertised as the WebRTC candidate (scripts/up.ps1 detects it when unset).
# With scripts/up.ps1, LIVEKIT_URL defaults to ws://<that LAN IP>:7880 and lan-relay.mjs forwards 7880/7881 to the Podman VM.
LIVEKIT_NODE_IP=

# Push notifications. Both are no-ops until configured.
# FCM HTTP v1: path to a Firebase service-account JSON file (inside the container if you mount it).
FCM_SERVICE_ACCOUNT_JSON=
# APNs token auth: .p8 key path, key id, team id, bundle id (topic). APNS_ENV=production for TestFlight/App Store builds.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_ENV=sandbox

# Guest sessions (POST /auth/guest) last this long.
GUEST_TTL_SECONDS=86400

# --- Used by the root compose.yaml (server container) ---
# Generate: node -e "console.log(require('crypto').randomBytes(36).toString('base64url').slice(0,48))"
# (JWT_SECRET above is also read by compose; keep it 32+ chars. Copy this file to the repo root as .env.)
