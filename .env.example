# Copy to server/.env (or export in your shell). The server reads process.env only; use
# `node --env-file=.env` or your process manager to load a file.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Postgres. Leave unset in development to use an embedded pglite database in server/data/pgdata.
DATABASE_URL=postgres://convoyage:convoyage@127.0.0.1:5432/convoyage
# Run pending migrations at startup (always on for the embedded fallback).
AUTO_MIGRATE=0

# Access-token signing secret (HS256), 32+ characters. Required in production; in development an
# ephemeral one is generated each start (all tokens die on restart).
JWT_SECRET=change-me-to-a-long-random-string-0123456789
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=60

# Email magic link. MAIL_DEV=1 logs the link and returns it in the response (never in production).
MAIL_DEV=1
# Deep link / URL the emailed link points at; `?token=...` is appended.
MAGIC_LINK_BASE_URL=convoyage://auth/magic

# Sign in with Apple / Google: comma-separated accepted `aud` values. Unset = provider disabled.
APPLE_AUDIENCES=
GOOGLE_AUDIENCES=

# WebSocket dev authenticator (?dev_user=alice). Never in production.
CONVOYAGE_DEV_AUTH=0

# Media (local disk in dev; S3 is a stub).
MEDIA_DIR=data/media

# Behind a reverse proxy, trust X-Forwarded-For for rate limits.
TRUST_PROXY=0
# Set to 1 to turn off the HTTP rate limits (tests).
RATE_LIMIT_DISABLED=0
