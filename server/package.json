{
  "name": "convoyage-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrateCli.ts",
    "migrate:prod": "node dist/db/migrateCli.js",
    "openapi": "tsx src/openapiCli.ts",
    "test": "tsx --test --test-concurrency=3 test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1167.0",
    "@fastify/multipart": "10.1.7",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.3",
    "fastify": "5.12.8",
    "jose": "6.2.15",
    "kysely": "0.29.8",
    "livekit-server-sdk": "2.19.2",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "ajv": "8.20.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
